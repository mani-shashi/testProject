# Copy this file to .env.local and replace every placeholder.
# Load it in every terminal before running commands:
#   set -a
#   source .env.local
#   set +a
#   printenv ConnectionStrings__AuthDb >/dev/null && echo "environment loaded"
#
# .env.local must never be committed or pasted into logs.

# SQL Server (Docker container). Host port 1434 maps to container 1433.
HOTEL_SQL_SA_PASSWORD=Replace-With-A-Strong-Password-1!
HOTEL_SQL_PORT=1434
HOTEL_SQL_CONNECTION='Server=localhost,1434;User Id=sa;Password=Replace-With-A-Strong-Password-1!;TrustServerCertificate=True;Encrypt=True'

# One database per service. No cross-database queries.
ConnectionStrings__AuthDb=Server=localhost,1434;Database=HotelAuthDb;User Id=sa;Password=Replace-With-A-Strong-Password-1!;TrustServerCertificate=True;Encrypt=True
ConnectionStrings__RoomDb=Server=localhost,1434;Database=HotelRoomDb;User Id=sa;Password=Replace-With-A-Strong-Password-1!;TrustServerCertificate=True;Encrypt=True
ConnectionStrings__GuestDb=Server=localhost,1434;Database=HotelGuestDb;User Id=sa;Password=Replace-With-A-Strong-Password-1!;TrustServerCertificate=True;Encrypt=True
ConnectionStrings__ReservationDb=Server=localhost,1434;Database=HotelReservationDb;User Id=sa;Password=Replace-With-A-Strong-Password-1!;TrustServerCertificate=True;Encrypt=True
ConnectionStrings__OperationsDb=Server=localhost,1434;Database=HotelOperationsDb;User Id=sa;Password=Replace-With-A-Strong-Password-1!;TrustServerCertificate=True;Encrypt=True

# JWT. Issuer, Audience and SigningKey must be identical in all services.
# SigningKey must be at least 32 bytes of random data.
Jwt__Issuer=HotelManagement
Jwt__Audience=HotelManagementClients
Jwt__SigningKey=Replace-With-At-Least-32-Random-Bytes
Jwt__ExpiryMinutes=120

# Shared key for service-to-service /internal/* endpoints.
# Not used by the gateway; internal routes are never exposed publicly.
InternalApi__Key=Replace-With-At-Least-32-Random-Bytes

# Development-only Owner account created on Auth Service startup.
Bootstrap__OwnerEmail=owner@hotel.local
Bootstrap__OwnerPassword=Replace-With-A-Strong-Password-1!
Bootstrap__OwnerFullName=Hotel Owner

# Service base URLs used for service-to-service calls.
# Auth is used by every service to check token revocation status.
Services__AuthBaseUrl=http://localhost:7001
Services__RoomBaseUrl=http://localhost:7002
Services__GuestBaseUrl=http://localhost:7003
Services__ReservationBaseUrl=http://localhost:7004

ASPNETCORE_ENVIRONMENT=Development
